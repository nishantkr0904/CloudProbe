.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
known_hosts

# ---- AWS local state ---------------------------------------------------
.aws/
aws-credentials

# ---- Runtime output — keep the directories, ignore their contents ------
reports/*
!reports/.gitkeep
logs/*
