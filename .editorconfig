# EditorConfig — https://editorconfig.org
# Cross-editor whitespace and EOL discipline for macOS, Linux, and Windows
# contributors. Overrides any editor-default that would introduce diffs.

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false  # Markdown line-break syntax uses trailing spaces

[*.{bat,cmd,ps1}]
end_of_line = crlf
